; The Bierstadt bar: a book's running head across the top of the screen.
;   left    the date and time, Contents (the applications menu) and the plates
;           I-IV, one per workspace
;   right   cpu, memory and disk in small caps, then network, bluetooth, a
;           volume slider and battery as icons from the bierstadt icon theme;
;           Fin. logs out
; Started by `bierstadt-bar start`. Colours: _dark.scss and _light.scss.

(deflisten workspaces :initial "[]" "bierstadt-bar workspaces")
(deflisten volume     :initial '{"pct":0,"muted":false,"out":""}' "bierstadt-bar volume")
(defpoll   network    :interval "10s" :initial '{"icon":"network-wireless-offline-symbolic","name":""}'
  "bierstadt-bar network")
(defpoll   bluetooth  :interval "10s" :initial '{"icon":"bluetooth-disabled-symbolic","tip":""}'
  "bierstadt-bar bluetooth-now")
(defpoll   clock      :interval "10s" :initial '{"short":"","long":""}'
  "date '+{\"short\":\"%a %d %b · %H:%M\",\"long\":\"%A %d %B %Y\"}'")

(defwidget sep [] (label :class "sep" :text "·"))

; A symbolic icon from the GTK icon theme (bierstadt or bierstadt-dark, set by
; bierstadt-mode). GTK draws it in the widget's CSS colour.
(defwidget glyph [name] (image :class "glyph" :icon name :icon-size "menu"))

(defwidget left []
  (box :class "left" :space-evenly false :halign "start" :spacing 24
    (label :class "clock" :tooltip {clock.long} :text {clock.short})
    (button :class "word" :onclick "xfdesktop --menu &" :onrightclick "xfce4-appfinder &"
            :tooltip "Click for the applications, right-click to search" "Contents")
    (box :class "plates" :space-evenly false :spacing 4
      (for w in workspaces
        (button :class {w.on ? "plate on" : "plate"}
                :tooltip {w.painting}
                :onclick "bierstadt-bar goto ${w.n}"
          {w.name})))))

(defwidget right []
  (box :class "right" :space-evenly false :halign "end" :spacing 14
    (button :class "word" :onclick "bierstadt-bar instruments" :tooltip "Processor, all cores. Click for btop"
      "cpu ${round(EWW_CPU.avg, 0)}%")
    (button :class "word" :onclick "bierstadt-bar instruments"
      :tooltip "${round(EWW_RAM.used_mem / 1073741824, 1)} of ${round(EWW_RAM.total_mem / 1073741824, 1)} GB in use"
      "mem ${round(EWW_RAM.used_mem_perc, 0)}%")
    (label :class "word" :tooltip "${round(EWW_DISK['/'].free / 1073741824, 0)} GB free on /"
      :text "disk ${round(EWW_DISK['/'].used_perc, 0)}%")
    (sep)
    (button :class "word" :onclick "bierstadt-bar wifi" :onrightclick "nm-connection-editor &"
            :tooltip "${network.name}. Click to join, right-click for saved connections"
      (glyph :name {network.icon}))
    (button :class "word" :onclick "bierstadt-bar bluetooth"
            :tooltip "Bluetooth: ${bluetooth.tip}. Click to connect a device"
      (glyph :name {bluetooth.icon}))
    (sep)
    (eventbox :onscroll "bierstadt-bar volume-{}"
      (box :class "volume" :space-evenly false :spacing 8
        (button :class "word" :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle" :onrightclick "bierstadt-bar sound"
                :tooltip "${volume.out}, ${volume.muted ? 'muted' : volume.pct + '%'}. Click to mute, right-click to choose speakers or microphone"
          (glyph :name {volume.muted || volume.pct == 0 ? "audio-volume-muted-symbolic"
                        : volume.pct < 34 ? "audio-volume-low-symbolic"
                        : volume.pct < 67 ? "audio-volume-medium-symbolic"
                        : "audio-volume-high-symbolic"}))
        (scale :class {volume.muted ? "slider muted" : "slider"} :min 0 :max 101 :value {volume.pct}
               :onchange "bierstadt-bar volume-set {}" :tooltip "Drag or scroll to change")))
    (sep)
    (box :class "word" :space-evenly false :spacing 6 :tooltip {EWW_BATTERY.BAT0.status}
      (glyph :name {"battery-${EWW_BATTERY.BAT0.capacity >= 90 ? 'full'
                               : EWW_BATTERY.BAT0.capacity >= 60 ? 'good'
                               : EWW_BATTERY.BAT0.capacity >= 30 ? 'medium'
                               : EWW_BATTERY.BAT0.capacity >= 10 ? 'low'
                               : 'caution'}${EWW_BATTERY.BAT0.status == 'Charging' ? '-charging'
                               : EWW_BATTERY.BAT0.status == 'Full' ? '-charged' : ''}-symbolic"})
      (label :text "${EWW_BATTERY.BAT0.capacity}%"))
    (button :class "word fin" :onclick "xfce4-session-logout --halt &" "Fin.")))

(defwidget bar []
  (centerbox :class "bar"
    (left)
    (box)
    (right)))

(defwindow bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "40px" :anchor "top center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  ; eww scales the bar for HiDPI but not the space it reserves, so this is
  ; 40px times the 2x scale. Use "40px" on a 1x screen.
  :reserve (struts :distance "80px" :side "top")
  (bar))
