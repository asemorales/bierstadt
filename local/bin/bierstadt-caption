#!/usr/bin/env bash
# bierstadt-caption: the small wall label in the bottom-left corner.
#
#   bierstadt-caption line1     ARTIST · TITLE · YEAR for the current workspace
#   bierstadt-caption line2     the painter's `life` sentence, if any
#   bierstadt-caption text      both lines as Conky markup
#   bierstadt-caption start     write the Conky config for the current mode and start it
#   bierstadt-caption stop
#   bierstadt-caption restart
#
# Conky asks for line1 and line2 every two seconds, so Conky updates the label
# after workspace changes and bierstadt-mode switches.

set -euo pipefail

TSV="$HOME/.local/share/bierstadt/paintings.tsv"
STATE_DIR="$HOME/.local/state/bierstadt"
CONF="$HOME/.config/conky/bierstadt.conf"

current_key() {
  local ws set
  ws=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null | awk '{ print $NF }')
  mapfile -t set < "$STATE_DIR/set"
  echo "${set[${ws:-0} % ${#set[@]}]}"
}

field() { awk -F'\t' -v k="$(current_key)" -v f="$1" '$1 == k { print $f }' "$TSV"; }

write_conf() {
  local mode bg label body
  mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo light)
  if [ "$mode" = dark ]; then
    bg=191612; label=9E958A; body=F2EDE4
  else
    bg=F2ECDF; label=6F6560; body=2F2620
  fi
  mkdir -p "$(dirname "$CONF")"
  cat > "$CONF" <<EOF
-- Generated by bierstadt-caption. Edit that script instead.
-- Sizes are in device pixels: the screen runs at 2x.
conky.config = {
  alignment = 'bottom_left',
  gap_x = 64,
  gap_y = 64,
  background = false,
  double_buffer = true,
  update_interval = 1,
  use_xft = true,
  font = 'Inter:pixelsize=24',
  default_color = '$body',
  color1 = '$label',
  draw_shades = false,
  draw_outline = false,
  draw_borders = false,
  border_inner_margin = 36,
  maximum_width = 1500,
  own_window = true,
  own_window_type = 'desktop',
  own_window_class = 'BierstadtCaption',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_transparent = false,
  own_window_argb_visual = true,
  own_window_argb_value = 217,
  own_window_colour = '$bg',
}

conky.text = [[
\${execpi 2 bierstadt-caption text}
]]
EOF
}

case "${1:-}" in
  line1) field 7 ;;
  line2) field 6 ;;
  text)
    printf '${font IBM Plex Mono:medium:pixelsize=22}${color1}%s' "$(field 7)"
    life=$(field 6)
    [ -n "$life" ] && printf '\n${voffset 10}${font Source Serif 4:italic:pixelsize=32}${color}%s' "$life"
    echo
    ;;
  start)
    command -v conky >/dev/null || { echo "Conky is not installed." >&2; exit 1; }
    write_conf
    pgrep -f "conky .*-c $CONF" >/dev/null || conky -d -q -c "$CONF" >/dev/null 2>&1
    ;;
  stop) pkill -f "conky .*-c $CONF" || true ;;
  restart) "$0" stop; sleep 0.3; "$0" start ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
