# Bierstadt: Adwaita's GTK 2 theme recoloured to the Bierstadt palette.
# Based on Bridge by ScionicSpectre
# vim:set ts=2 sw=2 sts=2 ai et:
#
# This is the GTK+ 2 version of Adwaita. It's whole purpose is to look as the
# GTK+ 3 version as much as possible until GTK+ 2 dies completely.
#
# Note: comments for explaining styles are on the bottom of each file beside the
# widget matches.

# Declare the colours used throughout the theme.
# There shouldn't be any fiddling with them in the theme files themselves in
# order to not mess up the dark theme.

# Text/base
gtk-color-scheme = "text_color:#F2EDE4\nbase_color:#191612"
# Foreground/background
gtk-color-scheme = "fg_color:#F2EDE4\nbg_color:#191612"
# Selected foreground/background
gtk-color-scheme = "selected_fg_color:#000000\nselected_bg_color:#E0D9CD"
# Insensitive foreground/background
gtk-color-scheme = "insensitive_fg_color:#81786D\ninsensitive_bg_color:#1F1B17"
# Menus
gtk-color-scheme = "menu_color:#25211C"
# Links
gtk-color-scheme = "link_color:#E0D9CD\nvisited_link_color:#9E958A"
# Treeview headers
gtk-color-scheme = "column_header_color:#9E958A\nhover_column_header_color:#FFFCF6"
# Window decoration
gtk-color-scheme = "window_color:#25211C"
# Tooltips
gtk-color-scheme = "tooltip_fg_color:#F2EDE4\ntooltip_bg_color:#25211C"

# Set GTK settings
gtk-auto-mnemonics              = 1
gtk-primary-button-warps-slider = 1

# And hand over the control to the theme files
include "main.rc"
include "apps.rc"
include "hacks.rc"
include "hacks-dark.rc"
