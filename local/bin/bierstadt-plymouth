#!/usr/bin/env bash

set -euo pipefail

DATA_DIR="$HOME/.local/share/bierstadt"
STATE_DIR="$HOME/.local/state/bierstadt"
TSV="$DATA_DIR/paintings.tsv"
OUT="$DATA_DIR/plymouth"
DEST=/usr/share/plymouth/themes/bierstadt
CONF=/etc/default/grub
DEFAULT_MODE=dark

mode=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "$DEFAULT_MODE")
key=$(head -n 1 "$DATA_DIR/room-$mode")
painting=$(awk -F'\t' -v k="$key" '$1 == k { print $2 }' "$TSV")
[ -s "$painting" ] || { echo "no painting for $key. Run bierstadt-mode data" >&2; exit 1; }

if [ "$mode" = dark ]; then
  wall="0.098, 0.086, 0.071"; line="#E3D8C4"
  ink="0.890, 0.847, 0.769"
  label="0.620, 0.584, 0.541"; plate="#191612"
else
  wall="0.949, 0.925, 0.875"; line="#231A15"
  ink="0.137, 0.102, 0.082"
  label="0.435, 0.396, 0.376"; plate="#F2ECDF"
fi

rm -rf "$OUT"
mkdir -p "$OUT"
convert "$painting" -resize 1920x1080 -strip "$OUT/painting.png"
convert -size 1x1 "xc:$line" "$OUT/line.png"
convert -size 1x1 "xc:$plate" "$OUT/plate.png"

cat > "$OUT/bierstadt.plymouth" <<EOF
[Plymouth Theme]
Name=Bierstadt
Description=The room's painting
ModuleName=script

[script]
ImageDir=$DEST
ScriptFile=$DEST/bierstadt.script
EOF

cat > "$OUT/bierstadt.script" <<EOF
# Bierstadt boot splash. Written by bierstadt-plymouth. Edit that script instead.

Window.SetBackgroundTopColor($wall);
Window.SetBackgroundBottomColor($wall);

w = Window.GetWidth();
h = Window.GetHeight();

painting = Image("painting.png");
scale = Math.Max(w / painting.GetWidth(), h / painting.GetHeight());
pic = painting.Scale(Math.Int(painting.GetWidth() * scale), Math.Int(painting.GetHeight() * scale));
wall_sprite = Sprite(pic);
wall_sprite.SetX(Window.GetX() + Math.Int((w - pic.GetWidth()) / 2));
wall_sprite.SetY(Window.GetY() + Math.Int((h - pic.GetHeight()) / 2));
wall_sprite.SetZ(0);
# No fade-in. Plymouth blends in software and takes about 10s to fade a full
# 4K frame. Every boot step that talks to Plymouth waits for it.

line = Image("line.png");
line_sprite = Sprite();
line_sprite.SetZ(10);
line_sprite.SetOpacity(0.55);
thick = Math.Max(Math.Int(h / 540), 2);

fun progress(duration, fraction) {
  line_sprite.SetImage(line.Scale(Math.Max(Math.Int(w * fraction), 1), thick));
  line_sprite.SetX(Window.GetX());
  line_sprite.SetY(Window.GetY() + h - thick);
}
Plymouth.SetBootProgressFunction(progress);

plate = Image("plate.png");
plate_sprite = Sprite();
plate_sprite.SetZ(14);
status_sprite = Sprite();
status_sprite.SetZ(15);

fun show_status(text) {
  if (text == "") {
    status_sprite.SetOpacity(0);
    plate_sprite.SetOpacity(0);
    return;
  }
  img = Image.Text(text, $label, 1, "Sans 10");
  th = img.GetHeight();
  pw = img.GetWidth() + 2 * th;
  ph = th * 2;
  px = Window.GetX() + Math.Int((w - pw) / 2);
  py = Window.GetY() + h - thick - ph - Math.Int(h / 60);
  plate_sprite.SetImage(plate.Scale(pw, ph));
  plate_sprite.SetPosition(px, py, 14);
  plate_sprite.SetOpacity(0.85);
  status_sprite.SetImage(img);
  status_sprite.SetPosition(px + th, py + Math.Int(th / 2), 15);
  status_sprite.SetOpacity(1);
}
Plymouth.SetUpdateStatusFunction(show_status);
Plymouth.SetMessageFunction(show_status);

prompt_sprite = Sprite();
prompt_sprite.SetZ(20);

fun password(prompt, bullets) {
  dots = "";
  for (i = 0; i < bullets; i++) dots += "•";
  text = Image.Text(prompt + "   " + dots, 1, 1, 1, 1, "Sans 14");
  prompt_sprite.SetImage(text);
  prompt_sprite.SetX(Window.GetX() + Math.Int((w - text.GetWidth()) / 2));
  prompt_sprite.SetY(Window.GetY() + Math.Int(h * 0.8));
  prompt_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password);

fun normal() { prompt_sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(normal);
EOF

sudo -v
sudo rm -rf "$DEST"
sudo install -d "$DEST"
sudo install -m644 "$OUT"/* "$DEST/"
sudo plymouth-set-default-theme bierstadt

[ -e "$CONF.pre-bierstadt" ] || sudo cp -p "$CONF" "$CONF.pre-bierstadt"
if ! grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=.*\bsplash\b' "$CONF"; then
  sudo sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*)"/\1 splash"/; s/^(GRUB_CMDLINE_LINUX_DEFAULT=") /\1/' "$CONF"
  sudo update-grub
fi

# When Plymouth quits normally, the system shows the text console, the boot log
# and a getty login prompt until X starts. Instead, X takes over vt1 without
# drawing a background, so the screen shows the painting until the greeter draws.
sudo tee /usr/local/sbin/bierstadt-splash-handoff >/dev/null <<'EOF'
#!/bin/sh
# Written by bierstadt-plymouth. Edit that script instead.
printf '\033[2J\033[3J\033[H' > /dev/tty1
plymouth quit --retain-splash
EOF
sudo chmod 755 /usr/local/sbin/bierstadt-splash-handoff
sudo install -d /etc/systemd/system/lightdm.service.d /etc/lightdm/lightdm.conf.d
printf '%s\n' '[Service]' 'ExecStartPre=-/usr/local/sbin/bierstadt-splash-handoff' |
  sudo tee /etc/systemd/system/lightdm.service.d/bierstadt-splash.conf >/dev/null
printf '%s\n' '[LightDM]' 'minimum-vt=1' '' '[Seat:*]' 'xserver-command=X -background none' |
  sudo tee /etc/lightdm/lightdm.conf.d/50-bierstadt-splash.conf >/dev/null
sudo systemctl daemon-reload
sudo systemctl disable getty@tty1.service
sudo ln -sfn /dev/null /etc/systemd/system/autovt@tty1.service

sudo update-initramfs -u
echo "boot splash: $mode, $key. Seen at the next boot."
